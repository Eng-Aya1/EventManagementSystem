@model IEnumerable<EventManagementSystem.Models.Event>

@{
    ViewData["Title"] = "Discover & Book Events";
}

<!-- Custom Styles to remove space below footer & center text -->
<style>
    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
    }

    body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    /* Target site layout footer, remove bottom spacing and force center layout */
    footer, .footer {
        margin-top: auto !important;
        margin-bottom: 0 !important;
        padding-top: 1.5rem !important;
        padding-bottom: 1.5rem !important;
        text-align: center !important;
        display: flex !important;
        justify-content: center !important;
        align-items: center !important;
    }

        footer *, .footer * {
            text-align: center !important;
        }
</style>

<!-- Notification Alerts -->
@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show my-3 p-3 shadow-sm rounded-4 border-0 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 bg-success-subtle border-start border-success border-4" role="alert">
        <div class="d-flex align-items-center gap-2">
            <span class="fs-4">🎉</span>
            <span class="fw-semibold text-success-emphasis">@TempData["Message"]</span>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <span class="small fw-bold text-muted me-1">Confirm Action?</span>

            <!-- Yes Button: Submits form to finalize booking and deduct ticket -->
            @if (TempData["PendingBookingId"] != null)
            {
                <form asp-controller="Home" asp-action="FinalizeBooking" method="post" class="m-0 p-0 d-inline">
                    <input type="hidden" name="id" value="@TempData["PendingBookingId"]" />
                    <input type="hidden" name="seatCategory" value="@TempData["PendingSeatCategory"]" />
                    <button type="submit" class="btn btn-sm btn-success fw-bold rounded-pill px-3">
                        ✓ Yes
                    </button>
                </form>
            }
            else
            {
                <button type="button" class="btn btn-sm btn-success fw-bold rounded-pill px-3" data-bs-dismiss="alert">
                    ✓ Yes
                </button>
            }

            <!-- No Button: Just dismisses the alert without triggering any database change -->
            <button type="button" class="btn btn-sm btn-outline-danger fw-bold rounded-pill px-3" data-bs-dismiss="alert">
                ✕ No
            </button>
        </div>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show my-3 p-3 shadow-sm rounded-4 border-0 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 bg-danger-subtle border-start border-danger border-4" role="alert">
        <div class="d-flex align-items-center gap-2">
            <span class="fs-4">⚠️</span>
            <span class="fw-semibold text-danger-emphasis">@TempData["Error"]</span>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <button type="button" class="btn btn-sm btn-danger fw-bold rounded-pill px-3" data-bs-dismiss="alert">
                Close
            </button>
        </div>
    </div>
}

<!-- Hero Section -->
<div class="bg-primary text-white rounded-4 p-5 mb-5 shadow-lg position-relative overflow-hidden" style="background: linear-gradient(135deg, #0d6efd 0%, #052c65 100%);">
    <div class="row align-items-center py-3">
        <div class="col-lg-7">
            <span class="badge bg-warning text-dark mb-3 px-3 py-2 fw-bold rounded-pill">🔥 Top Rated Event Platform</span>
            <h1 class="display-3 fw-bold mb-3">Discover, Choose Seats & Book Instantly</h1>
            <p class="lead mb-4 text-white-50">Explore top technology conferences, interactive workshops, and business networking events near you with real-time seat selection.</p>

            <!-- Working Search Bar -->
            <form asp-controller="Home" asp-action="Index" method="get" class="bg-white p-2 rounded-4 shadow d-flex gap-2">
                <input type="text" name="searchString" class="form-control border-0 shadow-none px-3" placeholder="Search events by name, topic or city...">
                <button type="submit" class="btn btn-primary px-4 fw-bold rounded-3">Search</button>
            </form>
        </div>
        <div class="col-lg-5 d-none d-lg-block text-center position-relative">
            <img src="https://images.unsplash.com/photo-1492684223066-81342ee5ff30?w=600" class="img-fluid rounded-4 shadow-lg border border-3 border-white-50" alt="Events Hero">
        </div>
    </div>
</div>

<!-- Category Filters & Header -->
<div id="events-section" class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1">Upcoming Events</h2>
        <p class="text-muted mb-0">Select an event below to choose your seat tier and book</p>
    </div>
    <div class="btn-group" role="group">
        <a asp-controller="Home" asp-action="Index" asp-route-category="All" class="btn btn-outline-primary fw-semibold">All</a>
        <a asp-controller="Home" asp-action="Index" asp-route-category="Tech" class="btn btn-outline-primary fw-semibold">Tech</a>
        <a asp-controller="Home" asp-action="Index" asp-route-category="Workshops" class="btn btn-outline-primary fw-semibold">Workshops</a>
        <a asp-controller="Home" asp-action="Index" asp-route-category="Business" class="btn btn-outline-primary fw-semibold">Business</a>
    </div>
</div>

<!-- Events Cards Grid -->
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100 shadow border-0 rounded-4 overflow-hidden position-relative card-hover">
                <span class="position-absolute top-0 end-0 m-3 badge rounded-pill px-3 py-2 bg-dark text-warning border border-warning">
                    @item.Category
                </span>
                <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title" style="height: 220px; object-fit: cover;">

                <div class="card-body p-4">
                    <h5 class="card-title fw-bold mb-2">@item.Title</h5>
                    <p class="card-text text-secondary small mb-3">@item.Description</p>

                    <div class="border-top pt-3 mt-3">
                        <div class="d-flex align-items-center text-muted small mb-2">
                            <span>📍 <strong>@item.Location</strong></span>
                        </div>
                        <div class="d-flex align-items-center text-muted small mb-2">
                            <span>📅 @item.StartDate.ToString("ddd, dd MMM yyyy")</span>
                        </div>
                        <div class="d-flex align-items-center text-success small fw-bold">
                            <span>Starting from: $@item.PriceStandard</span>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-light border-0 px-4 py-3 d-flex justify-content-between align-items-center">
                    <small class="text-danger fw-bold">🔥 @item.AvailableTickets seats left</small>
                    <button class="btn btn-primary btn-sm rounded-pill px-4 fw-bold"
                            data-bs-toggle="modal"
                            data-bs-target="#seatModal-@item.Id"
                            @(item.AvailableTickets == 0 ? "disabled" : "")>
                        Book Seats
                    </button>
                </div>
            </div>
        </div>

        <!-- Seat Selection & Confirmation Modal -->
        <div class="modal fade" id="seatModal-@item.Id" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-4 border-0 shadow-lg">
                    <div class="modal-header bg-dark text-white rounded-top-4">
                        <h5 class="modal-header-title mb-0 fw-bold">🎟️ Select Seat & Confirm - @item.Title</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <form asp-controller="Home" asp-action="ConfirmBooking" method="post">
                        <input type="hidden" name="id" value="@item.Id" />
                        <div class="modal-body p-4">
                            <p class="text-muted small mb-3">Choose your seating preferences based on stage proximity:</p>

                            <!-- Stage Indicator -->
                            <div class="bg-secondary text-white text-center py-1 rounded mb-4 fw-bold small">
                                🎬 STAGE / SCREEN AREA
                            </div>

                            <!-- Seat Options -->
                            <div class="mb-3 border p-3 rounded-3 bg-light">
                                <div class="form-check d-flex justify-content-between align-items-center">
                                    <div>
                                        <input class="form-check-input" type="radio" name="seatCategory" id="vip-@item.Id" value="Front Row (VIP)" checked onchange="updatePrice(@item.Id, @item.PriceVip)">
                                        <label class="form-check-label fw-bold text-primary" for="vip-@item.Id">
                                            VIP Front Row ⭐⭐⭐
                                        </label>
                                        <div class="small text-muted">Direct stage view + free refreshments</div>
                                    </div>
                                    <span class="fw-bold text-success">${@item.PriceVip}</span>
                                </div>
                            </div>

                            <div class="mb-3 border p-3 rounded-3 bg-light">
                                <div class="form-check d-flex justify-content-between align-items-center">
                                    <div>
                                        <input class="form-check-input" type="radio" name="seatCategory" id="mid-@item.Id" value="Middle Row" onchange="updatePrice(@item.Id, @item.PriceMiddle)">
                                        <label class="form-check-label fw-bold text-dark" for="mid-@item.Id">
                                            Middle Row (Standard Plus) ⭐⭐
                                        </label>
                                        <div class="small text-muted">Balanced view and comfortable distance</div>
                                    </div>
                                    <span class="fw-bold text-success">${@item.PriceMiddle}</span>
                                </div>
                            </div>

                            <div class="mb-3 border p-3 rounded-3 bg-light">
                                <div class="form-check d-flex justify-content-between align-items-center">
                                    <div>
                                        <input class="form-check-input" type="radio" name="seatCategory" id="back-@item.Id" value="Back Row" onchange="updatePrice(@item.Id, @item.PriceStandard)">
                                        <label class="form-check-label fw-bold text-secondary" for="back-@item.Id">
                                            Back Row (Economy) ⭐
                                        </label>
                                        <div class="small text-muted">Standard venue seating</div>
                                    </div>
                                    <span class="fw-bold text-success">${@item.PriceStandard}</span>
                                </div>
                            </div>

                            <input type="hidden" name="seatPrice" id="selectedPriceInput-@item.Id" value="@item.PriceVip" />

                            <div class="alert alert-warning small mb-0 mt-3 border-0">
                                ⚠️ <strong>Confirmation:</strong> By clicking confirm, 1 ticket will be assigned under your selected seating tier.
                            </div>
                        </div>
                        <div class="modal-footer bg-light rounded-bottom-4">
                            <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">Confirm Booking</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

<!-- Testimonials / Customer Reviews Section -->
